{
  "name": "embodied-datasets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Embodied Datasets: a community-maintained wiki of autonomous driving (and robotics) datasets with first-class availability tracking.",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "validate": "node scripts/validate.ts",
    "lint:prose": "node scripts/lint-prose.ts",
    "schema": "node scripts/export-schema.ts",
    "check": "npm run validate && npm run lint:prose && npm run schema"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.8",
    "d3-geo": "^3.1.1",
    "js-yaml": "^5.4.3",
    "marked": "^18.1.1",
    "pagefind": "^1.5.2",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/js-yaml": "^4.0.9",
    "@types/topojson-client": "^3.1.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embodied-datasets/embodied-datasets.github.io.git"
  },
  "homepage": "https://embodied-datasets.github.io/"
}
